# Mapbox public access token (pk.*) -- used both server-side (Directions) and client-side (Map)
NEXT_PUBLIC_MAPBOX_TOKEN=

# OpenWeatherMap API key -- used only server-side
OPENWEATHER_API_KEY=

# MLflow model server (from `make serve` in ../ml). Leave blank to disable ML scoring.
MLFLOW_SERVE_URL=http://localhost:5001/invocations
